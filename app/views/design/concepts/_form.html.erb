<%= render "design/shared/errors", record: @concept %>
<%= simple_form_for(@concept, url: (@concept.persisted? ? design_concept_path(@concept) : design_concepts_path)) do |f| %>
  <div class="row">
    <div class="col-md-6"><%= f.input :title %></div>
    <div class="col-md-3"><%= f.input :kind, collection: dc_options(Design::CONCEPT_KINDS), include_blank: false %></div>
    <div class="col-md-3"><%= f.input :status, collection: dc_options(Design::CONCEPT_STATUSES), include_blank: false %></div>
    <div class="col-md-8"><%= f.input :location, hint: "Which property or site this is for (free text)" %></div>
    <div class="col-md-4"><%= f.input :position, hint: "Sort order" %></div>
    <div class="col-12"><%= f.input :summary, hint: "One line shown on the card" %></div>
    <div class="col-12"><%= f.input :description, as: :text, input_html: { rows: 8 }, hint: "Goals, constraints, style direction, rooms, square footage…" %></div>
  </div>
  <%= f.button :submit, (@concept.persisted? ? "Save" : "Create concept"), class: "btn btn-primary" %>
  <%= link_to "Cancel", (@concept.persisted? ? design_concept_path(@concept) : design_concepts_path), class: "btn btn-link" %>
<% end %>
