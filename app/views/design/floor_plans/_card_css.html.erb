.fp-thumb { width: 100%; height: 170px; object-fit: contain; background: #fff; border-bottom: 1px solid #e3e5e8; display: block; }
.fp-thumb-empty { display: flex; align-items: center; justify-content: center; background: repeating-linear-gradient(0deg, #fafafa 0 11px, #f1f1f1 11px 12px), repeating-linear-gradient(90deg, #fafafa 0 11px, #f1f1f1 11px 12px); background-blend-mode: multiply; }
