<% content_for :wide, "1" %>
<% content_for :head do %>
  <style>
    .fp-editor { display: flex; flex-direction: column; height: calc(100vh - 150px); min-height: 520px; background: #fff; border: 1px solid #e3e5e8; border-radius: .4rem; overflow: hidden; }
    .fp-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; padding: .5rem .75rem; border-bottom: 1px solid #e3e5e8; background: #f8f9fa; }
    .fp-toolbar .btn.active { background: #1f2a37; border-color: #1f2a37; color: #fff; }
    .fp-body { display: flex; flex: 1; min-height: 0; }
    .fp-canvas-wrap { position: relative; flex: 1; min-width: 0; background: #fff; }
    .fp-canvas { display: block; touch-action: none; }
    .fp-hint { position: absolute; left: 10px; top: 8px; color: #6c757d; pointer-events: none; background: rgba(255,255,255,.85); padding: 2px 6px; border-radius: 3px; }
    .fp-panel { width: 290px; flex: none; overflow-y: auto; border-left: 1px solid #e3e5e8; padding: .75rem; background: #fbfbfc; }
    .fp-field { margin-bottom: .5rem; }
    .fp-field label { display: block; font-size: .72rem; color: #6c757d; margin-bottom: .1rem; }
    .fp-row { display: flex; gap: .5rem; } .fp-row .fp-field { flex: 1; }
    .fp-help { margin-top: 1rem; border-top: 1px solid #e3e5e8; padding-top: .5rem; }
    @media (max-width: 900px) { .fp-body { flex-direction: column; } .fp-panel { width: auto; border-left: 0; border-top: 1px solid #e3e5e8; max-height: 40%; } }
  </style>
  <%= javascript_include_tag "design/floorplan" %>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-2 dc-actions">
  <div>
    <nav class="small"><%= link_to "Concepts", design_concepts_path %> › <%= link_to @concept.title, design_concept_path(@concept, anchor: "plans") %> › <%= @plan.name %></nav>
    <h2 class="h5 mb-0"><%= @plan.name %><% if @plan.level.present? %> <span class="dc-muted small">· <%= @plan.level %></span><% end %></h2>
  </div>
  <div>
    <%= link_to "3D view", view3d_design_floor_plan_path(@plan), class: "btn btn-outline-primary btn-sm" %>
    <%= link_to "Settings", edit_design_floor_plan_path(@plan), class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Back to concept", design_concept_path(@concept, anchor: "plans"), class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<div id="fp-editor" class="fp-editor"></div>
<% if @plan.notes.present? %><div class="small dc-muted mt-2"><%= simple_format(@plan.notes) %></div><% end %>

<script type="application/json" id="fp-data"><%= raw @plan_json.to_json.gsub("</", "<\\/") %></script>
<script type="application/json" id="fp-siblings"><%= raw @siblings.to_json.gsub("</", "<\\/") %></script>
<script>
  (function () {
    var el = document.getElementById("fp-editor");
    var data = JSON.parse(document.getElementById("fp-data").textContent);
    window.fpEditor = FloorPlanEditor.mount(el, {
      data: data,
      widthFt: <%= @plan.width_ft.to_f %>,
      depthFt: <%= @plan.depth_ft.to_f %>,
      id: <%= @plan.id %>,
      name: <%= @plan.name.to_json.html_safe %>,
      level: <%= @plan.level.to_s.to_json.html_safe %>,
      concept: <%= @concept.title.to_json.html_safe %>,
      siblings: JSON.parse(document.getElementById("fp-siblings").textContent),
      saveUrl: <%= design_floor_plan_path(@plan, format: :json).to_json.html_safe %>,
      settingsUrl: <%= edit_design_floor_plan_path(@plan).to_json.html_safe %>,
      csrf: document.querySelector('meta[name="csrf-token"]').content
    });
  })();
</script>
