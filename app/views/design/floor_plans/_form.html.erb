<%= render "design/shared/errors", record: @plan %>
<%= simple_form_for(@plan, url: (@plan.persisted? ? design_floor_plan_path(@plan) : design_concept_floor_plans_path(@concept))) do |f| %>
  <div class="row">
    <div class="col-md-5"><%= f.input :name, hint: "e.g. Main floor, Second floor, Basement" %></div>
    <div class="col-md-3"><%= f.input :level, hint: "Optional label" %></div>
    <div class="col-md-2"><%= f.input :position, hint: "Sort order" %></div>
    <div class="col-md-3"><%= f.input :width_ft, label: "Drawing width (ft)", input_html: { step: 1 } %></div>
    <div class="col-md-3"><%= f.input :depth_ft, label: "Drawing depth (ft)", input_html: { step: 1 }, hint: "The dashed drawing area in the editor. Lot or footprint size works well; you can change it later." %></div>
    <div class="col-12"><%= f.input :notes, as: :text, input_html: { rows: 4 } %></div>
  </div>
  <%= f.button :submit, (@plan.persisted? ? "Save settings" : "Create and open editor"), class: "btn btn-primary" %>
  <%= link_to "Cancel", (@plan.persisted? ? design_floor_plan_path(@plan) : design_concept_path(@concept, anchor: "plans")), class: "btn btn-link" %>
<% end %>
