<div class="card dc-note h-100 <%= 'pinned' if note.pinned %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <h5 class="card-title h6 mb-1"><%= link_to note.title, design_note_path(note), class: "text-decoration-none text-dark" %><% if note.pinned %> <span title="Pinned">📌</span><% end %></h5>
      <span class="small dc-muted text-nowrap ms-2"><%= dc_date(note.updated_at, "%-m/%-d/%y") %></span>
    </div>
    <% if note.concept %><div class="small mb-1"><%= link_to note.concept.title, design_concept_path(note.concept), class: "text-decoration-none" %></div><% end %>
    <% if (ex = note.excerpt(240)).present? %><div class="small dc-note-body"><%= ex %></div><% end %>
    <% if note.tag_list.any? %><div class="mt-2"><%= dc_tags(note.tag_list) %></div><% end %>
    <div class="mt-2 small dc-actions">
      <%= link_to "Open", design_note_path(note) %> ·
      <%= link_to "Edit", edit_design_note_path(note) %> ·
      <%= link_to (note.pinned ? "Unpin" : "Pin"), toggle_pin_design_note_path(note), method: :patch %> ·
      <%= link_to "Delete", design_note_path(note), method: :delete, data: { confirm: "Delete this note?" }, class: "text-danger" %>
    </div>
  </div>
</div>
