<%# "Turn on notifications" for this device. Starts hidden: the script in
    family/shared/_push_menu shows it only when this browser has no push
    subscription (or can't have one, with a note saying why). Once a device is
    on, the card stays hidden and "Turn off" lives in the hamburger menu.
    Rendered only when push is configured (VAPID keys). %>
<% if FamilyPush.enabled? %>
  <% others = Family::PushSubscription.where(user: current_user).order(:created_at) %>
  <div class="fa-push" id="fa-push" hidden>
    <div class="fa-push-row">
      <div class="fa-push-text">
        <strong>Notifications</strong>
        <span class="fa-muted" id="fa-push-status">
          <% if others.any? %>
            On for <%= others.map(&:device_label).tally.map { |d, n| n > 1 ? "#{n} #{d.pluralize}" : d }.to_sentence %>, not on this device yet.
          <% else %>
            Get a ping on this device when someone adds something for you, plus the 7am digest.
          <% end %>
        </span>
        <div class="fa-muted small" id="fa-push-ios" hidden>
          On iPhone: tap Share → <em>Add to Home Screen</em>, then open Nash Family from there and tap Turn on.
        </div>
      </div>
      <div class="fa-push-actions">
        <button type="button" class="btn btn-primary btn-sm" id="fa-push-on" hidden>Turn on</button>
      </div>
    </div>
  </div>
<% end %>
