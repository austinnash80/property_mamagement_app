<%= form_with model: note,
              url: (note.persisted? ? family_note_path(note) : family_notes_path),
              local: true do |f| %>
  <% if note.errors.any? %>
    <div class="alert alert-danger py-2 small"><%= note.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= f.label :title, class: "form-label" %>
  <%= f.text_field :title, class: "form-control mb-3", autocomplete: "off" %>
  <%= f.label :body, "Notes", class: "form-label" %>
  <%= f.text_area :body, rows: 16, class: "form-control",
        placeholder: "Anything — half-formed ideas, a list, a draft. Nobody else sees this." %>
  <div class="mt-3 d-flex align-items-center gap-3">
    <%= f.submit (note.persisted? ? "Save" : "Create"), class: "btn btn-primary" %>
    <%= link_to "Cancel", family_notes_path, class: "btn btn-link fa-muted" %>
    <% if note.persisted? %>
      <%= link_to "Delete", family_note_path(note), method: :delete,
            data: { confirm: "Delete “#{note.title}”?" },
            class: "small text-decoration-none text-danger ms-auto" %>
    <% end %>
  </div>
<% end %>
