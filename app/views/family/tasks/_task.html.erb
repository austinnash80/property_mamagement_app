<%# One row of the list. The checkbox is a real form post - no JavaScript. %>
<div class="fa-task <%= "done" if task.done? %>" style="--fa-list: <%= task.list.color %>">
  <%= button_to toggle_family_task_path(task, list: params[:list], tag: params[:tag], person: params[:person]), method: :patch,
                class: "fa-check #{'is-done' if task.done?}", form_class: "d-inline",
                "aria-label": (task.done? ? "Mark as not done" : "Mark as done") do %>
    <span><%= "✓" if task.done? %></span>
  <% end %>

  <div class="fa-task-body">
    <div class="fa-task-title">
      <%= link_to task.title, family_task_path(task), class: "text-decoration-none text-reset" %>
    </div>
    <% if task.notes.present? %>
      <div class="small fa-muted text-truncate"><%= task.notes.to_s.squish.truncate(90) %></div>
    <% end %>
    <div class="fa-task-meta">
      <span class="fa-chip" style="background: <%= task.list.color %>1a; color: <%= task.list.color %>"><%= task.list.name %></span>
      <% task.tag_list.each do |tag| %><span class="fa-chip"><%= tag %></span><% end %>
      <% if task.assignee %><span><%= task.assignee.display_name %></span><% end %>
      <% if task.done? %>
        <span>Done <%= task.done_at.in_time_zone(Family::ZONE).strftime("%b %-d") %><%= " by #{task.done_by.display_name}" if task.done_by %></span>
      <% end %>
    </div>
  </div>

  <div class="fa-actions">
    <%= link_to "Edit", edit_family_task_path(task), class: "small text-decoration-none fa-muted me-2" %>
    <%= link_to "Delete", family_task_path(task), method: :delete,
                data: { confirm: "Delete “#{task.title}”?" }, class: "small text-decoration-none fa-muted" %>
  </div>
</div>
