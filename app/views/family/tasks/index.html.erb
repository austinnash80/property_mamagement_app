<%
  # Which view is this? The overview sends you here with one of these filters.
  view_name =
    if    @list            then @list.name
    elsif @tag             then @tag
    elsif @unassigned_only then "Unassigned"
    elsif @person          then (@person == current_user ? "Assigned to you" : "Assigned to #{@person.display_name}")
    else  "All open tasks"
    end
  view_color = @list&.color || "#2563eb"
%>

<div class="mb-2">
  <%= link_to "← All views", family_todo_path, class: "small fa-muted text-decoration-none" %>
</div>

<div class="fa-page-head">
  <h2>
    <span class="fa-dot" style="background: <%= view_color %>"></span><%= view_name %>
  </h2>
</div>

<%# Quick add, pre-filled for whichever view you are in. %>
<%= form_with model: @task, url: family_tasks_path, local: true, class: "mb-3" do |f| %>
  <%= hidden_field_tag :quick, 1 %>
  <%= hidden_field_tag :list,   params[:list] %>
  <%= hidden_field_tag :tag,    params[:tag] %>
  <%= hidden_field_tag :person, params[:person] %>
  <% if @task.errors.any? %>
    <div class="alert alert-danger py-2 small"><%= @task.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="input-group">
    <%= f.text_field :title, class: "form-control", placeholder: "Add a task…", autocomplete: "off" %>
    <% if @lists.any? %>
      <%= f.collection_select :list_id, @lists, :id, :name, {}, class: "form-select", style: "max-width: 13rem" %>
    <% end %>
    <%= f.submit "Add", class: "btn btn-primary" %>
  </div>
  <div class="row g-2 mt-2">
    <div class="col-6 col-sm-4">
      <%= f.date_field :due_on, class: "form-control form-control-sm", "aria-label": "Due date" %>
    </div>
    <div class="col-6 col-sm-4">
      <%= f.collection_select :assignee_id, @people, :id, :display_name,
            { include_blank: "Anyone" }, class: "form-select form-select-sm" %>
    </div>
    <div class="col-12 col-sm-4">
      <%= f.text_field :tags, class: "form-control form-control-sm",
            placeholder: "Tags, e.g. Errand", autocomplete: "off" %>
    </div>
  </div>
  <div class="mt-1"><%= render "family/shared/notify_checkbox", compact: true, id: "quick" %></div>
<% end %>

<%
  buckets = { overdue: "Overdue", today: "Today", week: "This week", later: "Later", none: "No date" }
  open_count = @buckets.values.sum(&:size)
%>

<% if open_count.zero? %>
  <p class="fa-muted text-center py-4 mb-0">
    Nothing open here.
    <%= link_to "Back to all views", family_todo_path, class: "text-decoration-none" %>
  </p>
<% end %>

<% buckets.each do |key, label| %>
  <% tasks = @buckets[key] || [] %>
  <% next if tasks.empty? %>
  <section class="fa-bucket" id="<%= key %>">
    <h2><%= label %> <span class="fa-muted">(<%= tasks.size %>)</span></h2>
    <%= render partial: "task", collection: tasks %>
  </section>
<% end %>

<% if @done.any? %>
  <details class="mt-4">
    <summary class="fa-muted small">Recently completed (<%= @done.size %>)</summary>
    <div class="mt-2"><%= render partial: "task", collection: @done %></div>
  </details>
<% end %>
