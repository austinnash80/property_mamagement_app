<%# The to-do overview: one card per list, showing what is at the top of it.
    Tap a card to open that list in full. %>
<% preview = Family::TasksController::PREVIEW %>

<div class="fa-page-head">
  <h2>To-do</h2>
  <p class="fa-muted mb-0">A card for each list — tap one to see everything on it.</p>
</div>

<%# Quick-add lives here too, so capturing a task never needs a detour. %>
<%= form_with model: @task, url: family_tasks_path, local: true, class: "mb-4" do |f| %>
  <%= hidden_field_tag :quick, 1 %>
  <%= hidden_field_tag :from, "overview" %>
  <% if @task.errors.any? %>
    <div class="alert alert-danger py-2 small"><%= @task.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="input-group">
    <%= f.text_field :title, class: "form-control", placeholder: "Add a task…", autocomplete: "off" %>
    <% if @lists.any? %>
      <%= f.collection_select :list_id, @lists, :id, :name, {}, class: "form-select", style: "max-width: 13rem" %>
    <% end %>
    <%= f.submit "Add", class: "btn btn-primary" %>
  </div>
  <div class="mt-1"><%= render "family/shared/notify_checkbox", compact: true, id: "quick" %></div>
<% end %>

<% if @lists.any? %>
  <div class="fa-cards">
    <% @lists.each do |list| %>
      <% tasks = @open_by_list[list.id] || [] %>
      <%= link_to family_tasks_path(list: list.id), class: "fa-card", style: "--fa-list: #{list.color}" do %>
        <div class="fa-card-head">
          <span class="fa-card-name"><%= list.name %></span>
          <span class="fa-card-n"><%= tasks.size %> open</span>
        </div>
        <% if tasks.any? %>
          <ul class="fa-card-items">
            <% tasks.first(preview).each do |task| %>
              <li>
                <span class="fa-card-title"><%= task.title %></span>
                <% if task.due_on %>
                  <span class="fa-card-due <%= "fa-due-over" if task.overdue? %>">
                    <%= task.due_on.strftime("%b %-d") %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
          <% if tasks.size > preview %>
            <p class="fa-card-more"><%= tasks.size - preview %> more…</p>
          <% end %>
        <% else %>
          <p class="fa-card-empty">Nothing open.</p>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="fa-muted small mb-0">No lists yet. <%= link_to "Add one", family_lists_path %> — Chores, Groceries, Honey-do.</p>
<% end %>

<p class="mt-4 small">
  <%= link_to "All open tasks", family_tasks_path, class: "text-decoration-none" %>
  <span class="fa-muted">·</span>
  <%= link_to "Edit lists", family_lists_path, class: "text-decoration-none" %>
</p>
