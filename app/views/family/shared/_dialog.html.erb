<%# Native <dialog> modal — no JS library needed, same vanilla approach as the
    header menu. A page opens one with a [data-open-dialog="id"] button and
    closes it with [data-close-dialog]; a dialog marked data-open-on-load opens
    itself (used to show validation errors after a failed save). %>
<style>
  .fa-modal { width: min(40rem, calc(100vw - 2rem)); border: 1px solid #e6e6e6; border-radius: .5rem;
              padding: 1rem 1.1rem 1.1rem; box-shadow: 0 1rem 2rem rgba(0,0,0,.18); }
  .fa-modal::backdrop { background: rgba(0,0,0,.35); }
  .fa-modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .75rem; }
</style>
<script>
  if (!window.__faDialog) {
    window.__faDialog = true;
    document.addEventListener("click", function (e) {
      var open = e.target.closest("[data-open-dialog]");
      if (open) { document.getElementById(open.dataset.openDialog).showModal(); return; }
      var close = e.target.closest("[data-close-dialog]");
      if (close) close.closest("dialog").close();
    });
  }
  // Reopen after a failed save so the validation errors are on screen.
  document.querySelectorAll("dialog[data-open-on-load]").forEach(function (d) { d.showModal(); });
</script>
