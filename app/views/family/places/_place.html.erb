<div class="fa-task <%= "visited" if place.visited? %>" style="--fa-list: <%= place.visited? ? '#0f766e' : '#b45309' %>">
  <%= button_to visit_family_place_path(place, view: params[:view], kind: params[:kind]), method: :patch,
                class: "fa-check #{'is-done' if place.visited?}", form_class: "d-inline",
                "aria-label": (place.visited? ? "Move back to want to go" : "Mark as been") do %>
    <span><%= "✓" if place.visited? %></span>
  <% end %>

  <div class="fa-task-body">
    <div class="fa-task-title">
      <%= link_to place.name, family_place_path(place), class: "text-decoration-none text-reset" %>
      <% if place.favorite %><span class="fa-star" title="Favorite">★</span><% end %>
    </div>
    <% if place.notes.present? %>
      <div class="small fa-muted text-truncate"><%= place.notes.to_s.squish.truncate(90) %></div>
    <% end %>
    <div class="fa-task-meta">
      <span class="fa-chip"><%= place.kind_label %></span>
      <% if place.area.present? %><span><%= place.area %></span><% end %>
      <% if place.visited? %>
        <span>Been <%= place.visited_at.in_time_zone(Family::ZONE).strftime("%b %-d, %Y") %></span>
      <% end %>
      <% if place.url.present? %>
        <%= link_to "Website ↗", place.url, target: "_blank", rel: "noopener noreferrer", class: "text-decoration-none" %>
      <% end %>
    </div>
  </div>

  <div class="fa-actions">
    <%= button_to favorite_family_place_path(place, view: params[:view], kind: params[:kind]), method: :patch,
                  class: "fa-starbtn #{'is-fav' if place.favorite}", form_class: "d-inline",
                  "aria-label": (place.favorite ? "Remove from favorites" : "Mark as a favorite") do %>
      <span>★</span>
    <% end %>
    <%= link_to "Edit", edit_family_place_path(place), class: "small text-decoration-none fa-muted ms-2" %>
  </div>
</div>
