<%= form_with model: list, url: (list.persisted? ? family_list_path(list) : family_lists_path), local: true do |f| %>
  <% if list.errors.any? %>
    <div class="alert alert-danger py-2 small"><%= list.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="row g-2 align-items-end">
    <div class="col-sm-6">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-control", placeholder: "Chores, Groceries, Honey-do" %>
    </div>
    <div class="col-sm-3">
      <%= f.label :color, class: "form-label" %>
      <%= f.select :color, Family::LIST_COLORS.map { |c| [c, c] }, {}, class: "form-select" %>
    </div>
    <div class="col-sm-3">
      <%= f.submit (list.persisted? ? "Save" : "Add list"), class: "btn btn-primary w-100" %>
    </div>
  </div>
<% end %>
