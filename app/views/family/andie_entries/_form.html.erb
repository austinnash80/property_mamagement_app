<%= form_with model: entry,
              url: (entry.persisted? ? family_andie_entry_path(entry) : family_andie_entries_path),
              local: true do |f| %>
  <% if entry.errors.any? %>
    <div class="alert alert-danger py-2 small"><%= entry.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="row g-2">
    <div class="col-sm-4">
      <%= f.label :title, "What is it", class: "form-label" %>
      <%= f.text_field :title, class: "form-control", placeholder: "Pediatrician" %>
    </div>
    <div class="col-sm-4">
      <%= f.label :value, "The answer", class: "form-label" %>
      <%= f.text_field :value, class: "form-control", placeholder: "phone number, address…" %>
    </div>
    <div class="col-sm-4">
      <%= f.label :section, class: "form-label" %>
      <%= f.select :section, Family::ANDIE_SECTIONS, {}, class: "form-select" %>
    </div>
  </div>
  <div class="mt-2">
    <%= f.label :notes, "Notes (optional)", class: "form-label" %>
    <%= f.text_area :notes, rows: 2, class: "form-control", placeholder: "Office hours, who to ask for, anything else." %>
  </div>
  <div class="mt-2 d-flex align-items-center gap-3 flex-wrap">
    <%= f.submit (entry.persisted? ? "Save" : "Add"), class: "btn btn-primary" %>
    <% unless entry.persisted? %><%= render "family/shared/notify_checkbox", compact: true, id: "andie" %><% end %>
    <% if entry.persisted? %>
      <%= link_to "Cancel", family_andie_entries_path, class: "btn btn-link fa-muted" %>
    <% end %>
  </div>
<% end %>
