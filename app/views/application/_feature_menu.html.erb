<%# Small hamburger menu for the feature section headers (top left). Carries the
    account controls that used to sit in each section's nav bar. A layout can add
    its own items above "Sign out" by passing `extra: "path/to/partial"`. %>
<style>
  .fm-bar { padding: .75rem .75rem .25rem; text-align: left; }
  .fm { position: relative; display: inline-block;
        font: 13px/1 verdana, arial, helvetica, sans-serif; }
  .fm > summary { list-style: none; cursor: pointer; display: inline-block;
                  padding: .4rem .55rem; color: #333; background: #fff;
                  border: 1px solid #e3e5e8; border-radius: .3rem; }
  .fm > summary::-webkit-details-marker { display: none; }
  .fm > summary:hover { border-color: #c9ced6; }
  .fm-panel { position: absolute; top: calc(100% + .25rem); left: 0; z-index: 30;
              min-width: 11rem; background: #fff; border: 1px solid #e3e5e8;
              border-radius: .3rem; box-shadow: 0 .25rem .75rem rgba(0,0,0,.12);
              padding: .25rem 0; }
  .fm-panel a, .fm-panel input[type="submit"], .fm-panel button {
              display: block; width: 100%; box-sizing: border-box; text-align: left;
              background: none; border: 0; padding: .45rem .9rem; color: #333;
              text-decoration: none; font: 13px/1.4 verdana, arial, helvetica, sans-serif;
              cursor: pointer; }
  .fm-panel a:hover, .fm-panel input[type="submit"]:hover, .fm-panel button:hover {
              background: #f4f3ef; color: #333; }
  .fm-panel form { margin: 0; padding: 0; }
  @media print { .fm-bar { display: none !important; } }
</style>
<div class="fm-bar">
  <details class="fm">
    <summary aria-label="Menu" title="Menu">&#9776;</summary>
    <div class="fm-panel">
      <% if signed_in? %>
        <% if full_access? %><%= link_to "Main home", root_path %><% end %>
        <%= link_to "Change password", edit_account_path %>
        <%= render extra if local_assigns[:extra] %>
        <%= button_to "Sign out", logout_path, method: :delete %>
      <% else %>
        <%= link_to "Sign in", login_path %>
      <% end %>
    </div>
  </details>
</div>
<script>
  // Close the menu on an outside click or Escape. Guarded because Turbolinks
  // re-runs body scripts on every visit.
  if (!window.__fmMenuClose) {
    window.__fmMenuClose = true;
    var fmCloseAll = function (except) {
      document.querySelectorAll("details.fm[open]").forEach(function (d) {
        if (!except || !d.contains(except)) d.open = false;
      });
    };
    document.addEventListener("click", function (e) { fmCloseAll(e.target); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") fmCloseAll(); });
  }
</script>
