<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Nash App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-0evHe/X+R7YkIZDRvuzKMRqM+OrBnVFBL6DOitfPri4tjfHxaWutUpFmBp4vmVor" crossorigin="anonymous">
    <%# Title face used by the property management header. %>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css?family=Playfair+Display+SC&display=swap" rel="stylesheet">
    <%# rails-ujs powers `method: :delete` links (the sign-out button) %>
    <script src="https://cdn.jsdelivr.net/npm/@rails/ujs@6.1.7/lib/assets/compiled/rails-ujs.js"></script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      <%# Matches what the property management pages actually render: Verdana 13px body,
          Playfair Display SC title. (header.scss asks for Open Sans but scaffolds.scss wins.) %>
      body { font-family: verdana, arial, helvetica, sans-serif; font-size: 13px; line-height: 18px;
             background: #fafafa; color: #333; }
      .hm-header { background: #fff; color: #333; box-shadow: 0 0 5px rgba(0, 0, 0, 0.1); }
      .hm-header h1 { font: normal 3.5em 'Playfair Display SC', serif; text-align: center;
                      margin: 0; padding-bottom: .5rem; }
      .hm-header h1 a { color: #333; text-decoration: none; }
      .hm-muted { color: #6c757d; }
      .hm-card { display: block; text-decoration: none; color: inherit;
                 background: #fff; border: 1px solid #e3e5e8; border-radius: .5rem;
                 border-top: 4px solid var(--hm-accent, #1f2a37); padding: 1.25rem 1.25rem 1rem; }
      .hm-card:hover { border-color: #c9ced6; border-top-color: var(--hm-accent, #1f2a37);
                       box-shadow: 0 .25rem .75rem rgba(0,0,0,.07); color: inherit; }
      .hm-card h2 { font-size: 1.15rem; margin-bottom: .35rem; }
      .hm-card p { font-size: .9rem; color: #6c757d; margin-bottom: .75rem; }
      .hm-stat { font-size: .8rem; color: #8a9099; }
      .hm-soon { opacity: .8; }
    </style>
  </head>
  <body>
    <header class="hm-header mb-4">
      <%= render "application/feature_menu" %>
      <h1><%= link_to "Nash App", root_path %></h1>
    </header>

    <div class="container pb-5">
      <% if notice.present? %><div class="alert alert-success py-2"><%= notice %></div><% end %>
      <% if alert.present?  %><div class="alert alert-danger py-2"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
