<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Project Portfolio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-0evHe/X+R7YkIZDRvuzKMRqM+OrBnVFBL6DOitfPri4tjfHxaWutUpFmBp4vmVor" crossorigin="anonymous">
    <%# Title face used by the property management header. %>
    <link href="https://fonts.googleapis.com/css?family=Playfair+Display+SC" rel="stylesheet">
    <%# rails-ujs powers `method: :delete` links and data-confirm dialogs %>
    <script src="https://cdn.jsdelivr.net/npm/@rails/ujs@6.1.7/lib/assets/compiled/rails-ujs.js"></script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      <%# Matches what the property management pages actually render: Verdana 13px body,
          Playfair Display SC title. (header.scss asks for Open Sans but scaffolds.scss wins.) %>
      body { font-family: verdana, arial, helvetica, sans-serif; font-size: 13px; line-height: 18px;
             background: #fafafa; color: #333; }
      .pf-header { background: #fff; color: #333; box-shadow: 0 0 5px rgba(0, 0, 0, 0.1); }
      .pf-header h1 { font: normal 3.5em 'Playfair Display SC', serif; text-align: center; margin: 0; }
      .pf-header h1 a { color: #333; text-decoration: none; }
      .pf-nav { max-width: 800px; margin: auto; display: flex; flex-wrap: wrap; }
      .pf-nav a, .pf-nav form { flex-grow: 1; text-align: center; padding: 1.25em; position: relative; }
      .pf-nav a { text-decoration: none; color: #000; }
      .pf-nav a::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
                         transform: scaleX(0); background: blue;
                         transition: 0.7s transform cubic-bezier(0.06, 0.9, 0.28, 1); }
      .pf-nav a:hover::after { transform: scaleX(1); }
      .pf-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: .75rem; }
      .pf-gallery figure { margin: 0; background: #fff; border: 1px solid #e3e5e8; border-radius: .4rem; overflow: hidden; }
      .pf-gallery img { width: 100%; height: 160px; object-fit: cover; display: block; }
      .pf-gallery figcaption { font-size: .8rem; padding: .35rem .5rem; }
      .pf-cover { width: 100%; height: 140px; object-fit: cover; border-radius: .4rem .4rem 0 0; }
      .pf-muted { color: #6c757d; }
      .pf-section { margin-top: 2rem; }
      @media print { .pf-nav, .pf-actions, .btn, form { display: none !important; } body { background: #fff; } }
      .pf-public .pf-actions, .pf-public .pf-private { display: none !important; }
    </style>
  </head>
  <body class="<%= 'pf-public' unless signed_in? %>">
    <header class="pf-header mb-4">
      <%= render "application/feature_menu" %>
      <h1><%= link_to "Project Portfolio", portfolio_root_path %></h1>
      <nav class="pf-nav">
        <%= link_to "Properties", portfolio_properties_path %>
        <%= link_to "All Projects", portfolio_projects_path %>
        <%= link_to "Vendors / Subs", portfolio_vendors_path %>
        <% if signed_in? %>
          <%= link_to "Inbox#{(n = Portfolio::SourceDocument.unreviewed.count) > 0 ? " (#{n})" : ""}", portfolio_inbox_path %>
          <a href="/design">Design Center</a>
          <a href="/pages/homepage">Property Management</a>
          <a href="/">Home</a>
        <% end %>
      </nav>
    </header>

    <div class="container pb-5">
      <% if notice.present? %><div class="alert alert-success py-2"><%= notice %></div><% end %>
      <% if alert.present?  %><div class="alert alert-danger py-2"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
