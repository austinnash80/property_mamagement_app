<!DOCTYPE html>
<html>
  <head>
    <title>Design Center</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-0evHe/X+R7YkIZDRvuzKMRqM+OrBnVFBL6DOitfPri4tjfHxaWutUpFmBp4vmVor" crossorigin="anonymous">
    <%# rails-ujs powers `method: :delete` links and data-confirm dialogs %>
    <script src="https://cdn.jsdelivr.net/npm/@rails/ujs@6.1.7/lib/assets/compiled/rails-ujs.js"></script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <style>
      body { background: #f4f3ef; }
      .dc-header { background: #1f2a37; color: #fff; }
      .dc-header h1 a { color: #fff; }
      .dc-nav a { text-decoration: none; margin-right: 1.25rem; color: #c9d1dc; font-weight: 500; }
      .dc-nav a:hover { color: #fff; }
      .dc-muted { color: #6c757d; }
      .dc-section { margin-top: 2rem; }
      .dc-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: .75rem; }
      .dc-gallery figure { margin: 0; background: #fff; border: 1px solid #e3e5e8; border-radius: .4rem; overflow: hidden; }
      .dc-gallery img { width: 100%; height: 170px; object-fit: cover; display: block; }
      .dc-gallery figcaption { font-size: .8rem; padding: .35rem .5rem; }
      .dc-cover { width: 100%; height: 150px; object-fit: cover; border-radius: .4rem .4rem 0 0; }
      .dc-note { background: #fffdf5; border-color: #ece6cf; }
      .dc-note.pinned { border-color: #e0b84a; }
      .dc-note-body { white-space: pre-wrap; }
      .dc-large { max-width: 100%; max-height: 80vh; border-radius: .4rem; background: #fff; }
      .dc-phase { border-style: dashed !important; background: transparent; }
      @media print { .dc-nav, .dc-actions, .btn, form { display: none !important; } body { background: #fff; } }
    </style>
  </head>
  <body>
    <header class="dc-header mb-4">
      <div class="container py-3 d-flex flex-wrap align-items-center justify-content-between">
        <div>
          <h1 class="h4 mb-1"><%= link_to "Design Center", design_root_path, class: "text-decoration-none" %></h1>
          <nav class="dc-nav small">
            <%= link_to "Dashboard", design_root_path %>
            <%= link_to "Concepts", design_concepts_path %>
            <%= link_to "Notes", design_notes_path %>
            <%= link_to "Images", design_images_path %>
            <%= link_to "Floor plans", design_floor_plans_path %>
          </nav>
        </div>
        <nav class="dc-nav small">
          <a href="/portfolio">Project Portfolio</a>
          <a href="/">← Property Management</a>
        </nav>
      </div>
    </header>

    <div class="<%= content_for?(:wide) ? "container-fluid px-4" : "container" %> pb-5">
      <% if notice.present? %><div class="alert alert-success py-2"><%= notice %></div><% end %>
      <% if alert.present?  %><div class="alert alert-danger py-2"><%= alert %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
