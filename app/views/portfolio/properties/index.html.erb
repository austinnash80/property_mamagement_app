<div class="d-flex justify-content-between align-items-center mb-3 pf-actions">
  <h2 class="h4 mb-0">Properties</h2>
  <div>
    <%= link_to "Download CSV", export_csv_portfolio_properties_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "New Property", new_portfolio_property_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<div class="row g-3">
  <% @properties.each do |property| %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <% if property.cover_photo.attached? %>
          <%= link_to portfolio_property_path(property) do %>
            <%= image_tag property.cover_photo.variant(resize_to_limit: [800, 400]), class: "pf-cover" %>
          <% end %>
        <% end %>
        <div class="card-body">
          <h5 class="card-title mb-1"><%= link_to property.name, portfolio_property_path(property), class: "text-decoration-none" %></h5>
          <div class="small pf-muted"><%= property.address %></div>
          <div class="mt-2">
            <%= status_badge(property.status) %>
            <span class="badge bg-light text-dark"><%= property.property_type&.capitalize %></span>
          </div>
          <div class="mt-3 small">
            <strong><%= property.projects.size %></strong> project<%= "s" unless property.projects.size == 1 %>
            &middot; <strong><%= money(property.total_cost) %></strong> documented
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
<% if @properties.empty? %>
  <p class="pf-muted">No properties yet. Run <code>rails portfolio:seed_properties</code> or add one.</p>
<% end %>
