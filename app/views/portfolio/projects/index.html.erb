<div class="d-flex justify-content-between align-items-center mb-3 pf-actions">
  <h2 class="h4 mb-0">All Projects <span class="pf-muted small">by date</span></h2>
  <div>
    <%= link_to "Download CSV", export_csv_portfolio_projects_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "New Project", new_portfolio_project_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>
<div class="card"><div class="card-body p-0">
<table class="table table-hover mb-0">
  <thead><tr><th>Dates</th><th>Property</th><th>Project</th><th>Trades</th><th>Status</th><th class="text-end">Cost</th></tr></thead>
  <tbody>
    <% @projects.each do |p| %>
      <tr>
        <td class="small text-nowrap"><%= p.date_range.presence || "—" %></td>
        <td><%= link_to p.property.name, portfolio_property_path(p.property), class: "text-decoration-none" %></td>
        <td><%= link_to p.title, portfolio_project_path(p), class: "text-decoration-none fw-semibold" %><div class="small pf-muted"><%= p.summary %></div></td>
        <td class="small"><%= p.trades.join(", ") %></td>
        <td><%= status_badge(p.status) %></td>
        <td class="text-end"><%= money(p.total_cost) %></td>
      </tr>
    <% end %>
    <% if @projects.empty? %><tr><td colspan="6" class="pf-muted">No projects yet.</td></tr><% end %>
  </tbody>
</table>
</div></div>
