<nav class="small mb-2"><%= link_to "Inbox", portfolio_inbox_path %> › <%= @doc.title.to_s.truncate(80) %></nav>
<div class="row g-3">
  <div class="col-lg-7">
    <h2 class="h5"><%= @doc.title %></h2>
    <div class="pf-muted small mb-2"><%= @doc.source %> · <%= @doc.source_ref %> · <%= pdate(@doc.occurred_on) %> · <%= @doc.vendor %> · <%= status_badge(@doc.status) %>
      <% @doc.flag_list.each do |fl| %><span class="badge bg-warning text-dark ms-1"><%= fl %></span><% end %></div>
    <% if @doc.description.present? %><p class="small"><%= simple_format(@doc.description) %></p><% end %>

    <% if @doc.line_items.any? %>
      <h3 class="h6 mt-3">Line items</h3>
      <table class="table table-sm">
        <thead><tr><th>Description</th><th>Dept / Class</th><th class="text-end">Qty</th><th class="text-end">Unit</th><th class="text-end">Total</th></tr></thead>
        <tbody>
          <% @doc.line_items.each do |li| %>
            <tr><td><%= li["description"] %><div class="pf-muted small"><%= [li["brand"], li["model"], li["sku"]].compact_blank.join(" · ") %></div></td>
              <td class="small"><%= li["department"] %> / <%= li["class_name"] %></td>
              <td class="text-end"><%= li["qty"] %></td><td class="text-end"><%= money(li["unit_price"]) %></td><td class="text-end"><%= money(li["line_total"]) %></td></tr>
          <% end %>
        </tbody>
        <tfoot><tr><th colspan="4" class="text-end">Total</th><th class="text-end"><%= money(@doc.amount) %></th></tr></tfoot>
      </table>
    <% end %>

    <h3 class="h6 mt-3">Files (<%= @doc.files.size %>)</h3>
    <div class="pf-gallery mb-3">
      <% @doc.image_files.each do |f| %>
        <figure><%= link_to url_for(f), target: "_blank" do %><%= image_tag f.variant(resize_to_limit: [400, 400]) rescue image_tag(f) %><% end %><figcaption><%= f.filename.to_s.truncate(40) %></figcaption></figure>
      <% end %>
    </div>
    <ul class="small">
      <% @doc.document_files.each do |f| %>
        <li><%= link_to "#{file_icon(f.blob)} #{f.filename}", url_for(f), target: "_blank" %> <span class="pf-muted">(<%= number_to_human_size(f.blob.byte_size) %>)</span></li>
      <% end %>
    </ul>
    <% pdf = @doc.document_files.find { |f| f.blob.content_type.to_s.include?("pdf") } %>
    <% if pdf %><iframe src="<%= url_for(pdf) %>" style="width:100%;height:720px;border:1px solid #ddd;border-radius:4px"></iframe><% end %>
  </div>

  <div class="col-lg-5">
    <div class="card"><div class="card-body">
      <h3 class="h6">Triage</h3>
      <%= simple_form_for(@doc, url: portfolio_source_document_path(@doc), method: :patch) do |f| %>
        <%= f.input :status, collection: Portfolio::SourceDocument::STATUSES.map { |s| [s.humanize, s] }, include_blank: false %>
        <%= f.input :project_id, label: "Assign to project", collection: @projects, label_method: ->(p) { "#{p.property.name}: #{p.title}" }, value_method: :id, include_blank: "— none —" %>
        <div class="row">
          <div class="col-6"><%= f.input :property_guess, collection: Portfolio::Property.ordered.pluck(:name), include_blank: true %></div>
          <div class="col-6"><%= f.input :kind, collection: Portfolio::SourceDocument::KINDS, include_blank: false %></div>
        </div>
        <div class="row">
          <div class="col-6"><%= f.input :occurred_on, as: :date, html5: true %></div>
          <div class="col-6"><%= f.input :amount %></div>
        </div>
        <%= f.input :vendor %>
        <%= f.input :title %>
        <%= f.input :flags, hint: "Space separated, e.g. CABINET FLOORING" %>
        <%= f.input :suggested_group %>
        <%= f.input :notes, as: :text, input_html: { rows: 3 } %>
        <%= f.button :submit, "Save", class: "btn btn-primary" %>
      <% end %>
      <% if @doc.project %>
        <hr>
        <div class="small mb-1">Add to <strong><%= @doc.project.title %></strong> as:</div>
        <%= button_to "Expense (with receipt)", promote_portfolio_source_document_path(@doc, as: "expense"), class: "btn btn-outline-dark btn-sm me-1" %>
        <%= button_to "Document", promote_portfolio_source_document_path(@doc, as: "document"), class: "btn btn-outline-dark btn-sm me-1" %>
        <% if @doc.image_files.any? %><%= button_to "Photos", promote_portfolio_source_document_path(@doc, as: "photos"), class: "btn btn-outline-dark btn-sm" %><% end %>
        <% if @doc.metadata["promoted_as"] %><div class="small text-success mt-1">Already promoted as <%= @doc.metadata["promoted_as"] %>.</div><% end %>
      <% end %>
    </div></div>
    <% if @neighbors.any? %>
      <div class="card mt-3"><div class="card-body">
        <h3 class="h6">Other documents from <%= @doc.vendor %></h3>
        <ul class="small mb-0"><% @neighbors.each do |n| %><li><%= link_to "#{pdate(n.occurred_on, '%-m/%-d/%y')} · #{n.title.to_s.truncate(50)}", portfolio_source_document_path(n) %> <%= status_badge(n.status) %></li><% end %></ul>
      </div></div>
    <% end %>
    <div class="mt-3 small"><%= link_to "Delete this document", portfolio_source_document_path(@doc), method: :delete, data: { confirm: "Delete permanently?" }, class: "text-danger" %></div>
  </div>
</div>
