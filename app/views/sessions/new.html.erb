<h1 class="h4 mb-1">Nash Properties</h1>
<p class="text-muted small mb-4">Sign in to manage properties, the portfolio and the Design Center.</p>
<%= form_with url: login_path, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, value: params[:email], class: "form-control", autofocus: true, autocomplete: "username", required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :password, class: "form-label" %>
    <%= f.password_field :password, class: "form-control", autocomplete: "current-password", required: true %>
  </div>
  <%= f.button "Sign in", class: "btn btn-primary w-100" %>
  <div class="form-text mt-2">You stay signed in on this browser until you sign out.</div>
<% end %>
<div class="mt-3 small"><a href="/portfolio" class="text-decoration-none">View the public project portfolio →</a></div>
